#!/usr/bin/env bash
# Send the arm home, as the controller's B button: the teleop opens the gripper and moves slowly to
# the untuck pose; the runtime clears the policy's chunks. If scripts/start is on, the policy resumes
# fresh once the arm is home (scripts/stop first to stay there).
cd "$(dirname "$0")/.." && source launch/env.sh
# Two-arm homing releases the shared run FIRST and stays stopped throughout homing.
if [[ -n "$HOME_TOPIC_OTHER" ]]; then
    timeout 10 ros2 service call "$ENGAGE" std_srvs/srv/SetBool "{data: false}" >/dev/null \
        || { echo "Could not stop both arms on $ENGAGE; refusing to home." >&2; exit 1; }
fi
# Wait for every subscriber (teleop and runtime) before the one message: over zenoh a publish
# sent before discovery completes is dropped.
for HOME_TOPIC in "$HOME_TOPIC" ${HOME_TOPIC_OTHER:+"$HOME_TOPIC_OTHER"}; do
SUBS=$(timeout 10 ros2 topic info "$HOME_TOPIC" 2>/dev/null | sed -n 's/^Subscription count: //p')
if [[ -z "$SUBS" || "$SUBS" == 0 ]]; then
    echo "Nothing listens on $HOME_TOPIC (ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}): is the teleop up?" >&2
    exit 1
fi
if timeout 10 ros2 topic pub --once -w "$SUBS" "$HOME_TOPIC" std_msgs/msg/Empty "{}" >/dev/null; then
    echo "Homing (${SUBS} listeners on ${HOME_TOPIC}). scripts/start to run the policy again."
else
    echo "Home request on $HOME_TOPIC was not delivered in 10 s" >&2; exit 1
fi
done
