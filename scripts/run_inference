#!/usr/bin/env bash
# Run a downloaded policy checkpoint (models/<name>_*/step-<N>/) on the arm, in tmux.
# Usage: scripts/run_inference --NAME [STEP] [options]
#        scripts/run_inference --model DIR|REPO [--revision REV] [options]
#   --NAME       checkpoint name or a unique prefix, e.g. --act, --smolvla_CupToContainer
#   STEP         training step (default: newest)
#   --model M    a checkpoint directory or Hub repo (user/name) instead of a downloaded --NAME
#   --revision R with a Hub --model: its branch, tag or commit (e.g. step-030000)
#   --adapter D  VITA LoRA adapter directory (inference.lora), on the checkpoint's flow net
#   --alpha A    with --adapter: its weight, 0 the base exactly (default 1)
#   --episode N  sim: shadow rollout of recorded episode N (default 4); refused with live cameras
#   --replay BAG two-arm (*SweepTrash*): serve this kinesthetic recording in place of the network, as the
#                checkpoint runs (inference serve --replay); scripts/start once the arms are at its start
#   --config F   RethoughtAI config (default: configs/baxter.yaml; *SweepTrash*: baxter_bimanual.yaml)
#   --device D   torch device (default: cuda)
#   --list       list the downloaded checkpoints
#   --resolve    print the checkpoint folder it would run, and exit
# Teleop first: baxter_sdk scripts/run_teleop.sh --left --policy (two arms: --both --policy --no-gripper).
# Then scripts/start connects the policy, scripts/stop holds the arm, scripts/home sends it home.

# The policy runs in the top pane, a shell below has scripts/start typed. On the real robot the
# policy watches its cameras; with none up (the sim) it runs a shadow rollout of a recorded episode.
# Examples:
#   scripts/run_inference --act 100000
#   scripts/run_inference --smolvla_CupToContainer 30000 --episode 24
#   scripts/run_inference --smolvla_CupToContainer_wrist   newest checkpoint (wrist camera only)
#   scripts/run_inference --multitaskdit                   MultiTask DiT (BlueCupToContainer)
#   scripts/run_inference --groot                          GR00T N1.7 3B: needs a GPU with ~10 GB (--device: torch device)
#   scripts/run_inference --vita_BlueCupRedContainer_kin_pose 70000
#   scripts/run_inference --vita_BlueCupRedContainer_kin_lead640ms 80000
#   scripts/run_inference --vita_SweepTrash_Kin 50000      automatically uses baxter_bimanual.yaml
#   scripts/run_inference --multi_task_dit_SweepTrash_Kin-Full_inpainted_minimax 30000   any *SweepTrash*: bimanual; full name if ambiguous
#   scripts/run_inference --multi_task_dit_kin_pose_combo_30k_r5h100 30000   kinesthetic cup MultiTask DiT
#   scripts/run_inference --model andnetdeboer/vita_X --revision step-030000 --adapter adapters/t1 --alpha 0.5

set -eo pipefail
cd "$(dirname "$0")/.."

NAME="" STEP="" EPISODE="" CONFIG=configs/baxter.yaml DEVICE=cuda RESOLVE="" LIST="" CONFIG_GIVEN=""
MODEL="" REVISION="" ADAPTER="" ALPHA="" REPLAY=""
while (( $# )); do
    case "$1" in
        --model) MODEL="$2"; shift ;;
        --revision) REVISION="$2"; shift ;;
        --adapter) ADAPTER="$(realpath "$2")"; shift ;;
        --replay) REPLAY="$(realpath "$2")"; shift ;;
        --alpha) ALPHA="$2"; shift ;;
        --resolve) RESOLVE=1 ;;
        --list) LIST=1 ;;
        --episode) EPISODE="$2"; shift ;;
        --config) CONFIG="$2"; CONFIG_GIVEN=1; shift ;;
        --device) DEVICE="$2"; shift ;;
        -h|--help) sed -n '2,/^$/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0 ;;
        --*) NAME="${1#--}"; [[ "${2:-}" =~ ^(step-)?[0-9]+$ ]] && { STEP="$2"; shift; } ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done
if [[ -n "$LIST" ]]; then
    find models -mindepth 3 -maxdepth 3 -name config.json -printf '%h\n' | sort -V
    exit 0
fi
[[ -z "$ALPHA" || -n "$ADAPTER" ]] || { echo "--alpha needs --adapter" >&2; exit 2; }
[[ -z "$ADAPTER" || -f "$ADAPTER/adapter.json" ]] || { echo "--adapter $ADAPTER: no adapter.json there" >&2; exit 2; }
if [[ -n "$MODEL" ]]; then
    [[ -z "$NAME" ]] || { echo "Give --model or --$NAME, not both" >&2; exit 2; }
    [[ ! -d "$MODEL" ]] || MODEL="$(realpath "$MODEL")"
else
    [[ -n "$NAME" ]] || { echo "Name a model: scripts/run_inference --act 100000 (models: $(find models -mindepth 1 -maxdepth 1 -printf '%f ' 2>/dev/null))" >&2; exit 2; }

    # models/<name> exactly, else models/<name>_* (those with step-<N>, if given); then its step-<N>
    # (newest without a step)
    shopt -s nullglob
    step_dirs() {
        local d digits
        for d in "$1"/step-*; do
            digits="${d##*/step-}"
            [[ -d "$d" && "$digits" =~ ^[0-9]+$ && -f "$d/config.json" ]] || continue
            if [[ -z "$STEP" ]] || (( 10#$digits == 10#${STEP#step-} )); then
                printf '%s\n' "$d"
            fi
        done
    }
    dirs=()
    if [[ -d models/"$NAME" ]]; then
        dirs=(models/"$NAME")
    else
        for d in models/"$NAME"_*; do [[ -d "$d" && -n "$(step_dirs "$d")" ]] && dirs+=("$d"); done
    fi
    if (( ${#dirs[@]} != 1 )); then
        echo "--$NAME${STEP:+ $STEP}: ${#dirs[@]} matching downloaded models. Steps are exact: 3000 is not 30000." >&2
        echo "Available matching checkpoints (use the full model name if ambiguous):" >&2
        for d in models/"$NAME" models/"$NAME"_*; do
            [[ -d "$d" ]] || continue
            printf '  %s:' "${d#models/}" >&2
            for checkpoint in "$d"/step-*; do [[ -f "$checkpoint/config.json" ]] && printf ' %s' "${checkpoint##*/}" >&2; done
            printf '\n' >&2
        done
        exit 2
    fi
    matches=()
    while IFS= read -r checkpoint; do [[ -n "$checkpoint" ]] && matches+=("$checkpoint"); done < <(step_dirs "${dirs[0]}" | sort -V)
    (( ${#matches[@]} )) || { echo "No downloaded step ${STEP:-latest} for ${dirs[0]}; use --list to see available checkpoints." >&2; exit 2; }
    if [[ -n "$STEP" ]] && (( ${#matches[@]} > 1 )); then
        echo "Duplicate numeric checkpoint step: ${matches[*]}; remove ambiguity before launching." >&2
        exit 2
    fi
    MODEL="${matches[${#matches[@]}-1]}"
fi
[[ -n "$RESOLVE" ]] && { echo "$MODEL"; exit 0; }
if [[ "$NAME" == *SweepTrash* && -z "$CONFIG_GIVEN" ]]; then
    CONFIG=configs/baxter_bimanual.yaml
fi
export CONFIG
EPISODE_DIR="recorder/data/CupToContainer/episode_$(printf %03d "$((10#${EPISODE:-4}))")"

source launch/env.sh
# Reject unsupported layouts before stopping an existing run or touching ROS services.
.venv/bin/inference check "$MODEL" --config "$CONFIG" ${REVISION:+--revision "$REVISION"}
SESSION=rai_inference

# One run at a time: two runtimes would fight over the arm.
old_runs() {  # pids of a previous run, never this script or the shells that started it
    local mine=" " p=$$
    while (( p > 1 )); do mine+="$p "; p=$(awk '/^PPid/ {print $2}' /proc/"$p"/status); done
    for p in $(pgrep -f "policy.launch.py|inference serve|inference run|ros2 bag play"); do
        [[ "$mine" == *" $p "* ]] || echo "$p"
    done
}
timeout 10 ros2 topic echo --once /robot/joint_states >/dev/null 2>&1 \
    || echo "Warning: no /robot/joint_states on ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}: is the sim (or robot) up?" >&2

# Live cameras (the real robot) or none (the sim): a bag played over live cameras would mix its
# frames with theirs.
live=()
for topic in $(python3 -c "import yaml,sys; print(*(c['topic'] for c in yaml.safe_load(open(sys.argv[1]))['topics']['images']))" "$CONFIG"); do
    [[ "$(timeout 5 ros2 topic info "$topic" 2>/dev/null)" =~ Publisher\ count:\ [1-9] ]] && live+=("$topic")
done
LAUNCH="ros2 launch launch/policy.launch.py model:=$MODEL config:=$CONFIG device:=$DEVICE"
LAUNCH+="${REVISION:+ revision:=$REVISION}${ADAPTER:+ adapter:=$ADAPTER}${ALPHA:+ alpha:=$ALPHA}${REPLAY:+ replay:=$REPLAY}"
if (( ${#live[@]} )); then
    [[ -z "$EPISODE" ]] || { echo "--episode $EPISODE: the robot's cameras are up (${live[*]}), and a shadow rollout would mix their frames with the bag's" >&2; exit 2; }
    echo "Live: the robot's cameras (${live[*]})"
else
    if [[ "$NAME" == vita_BlueCupRedContainer_kin_* || "$NAME" == *SweepTrash* || "$NAME" == vita_kin_* || "$NAME" == multi_task_dit_kin_* ]]; then
        echo "No live cameras: kinesthetic models must not silently shadow the old CupToContainer episode. Use live cameras; kinesthetic shadow playback needs measured start poses and matching image transport." >&2
        exit 2
    fi
    [[ -d "$EPISODE_DIR" ]] || { echo "No cameras up and no episode $EPISODE_DIR to shadow" >&2; exit 2; }
    echo "No cameras up: shadow rollout of $EPISODE_DIR"
    LAUNCH+=" episode:=$EPISODE_DIR"
fi
# All preflight checks passed: only now replace a previous runtime.
if [[ -n "$(old_runs)" ]]; then
    echo "Stopping the previous run..."
    timeout 5 ros2 service call "$ENGAGE" std_srvs/srv/SetBool "{data: false}" >/dev/null 2>&1 || true
    mapfile -t runs < <(old_runs)
    kill -INT "${runs[@]}" 2>/dev/null || true
    for _ in $(seq 20); do [[ -z "$(old_runs)" ]] && break; sleep 0.5; done
    mapfile -t runs < <(old_runs)
    if (( ${#runs[@]} )); then kill -TERM "${runs[@]}" 2>/dev/null || true; fi
fi
tmux kill-session -t "$SESSION" 2>/dev/null || true
tmux new-session -d -s "$SESSION" -c "$PWD" -e ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}" -e CONFIG="$CONFIG" \
    "source launch/env.sh; echo 'Model: $MODEL'; $LAUNCH; read -rp 'Policy stopped. Enter to close.'"
tmux split-window -v -l 8 -t "$SESSION" -c "$PWD" -e ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}" -e CONFIG="$CONFIG"
for _ in $(seq 50); do [[ -n "$(tmux capture-pane -p -t "$SESSION":0.1 | tr -d "[:space:]")" ]] && break; sleep 0.1; done
# typed at the prompt, not entered; a non-default domain spelled out (shell rc files may unset it)
tmux send-keys -t "$SESSION":0.1 "${ROS_DOMAIN_ID:+ROS_DOMAIN_ID=$ROS_DOMAIN_ID }scripts/start"
if [[ -t 1 ]]; then
    if [[ -n "$TMUX" ]]; then tmux switch-client -t "$SESSION"; else tmux attach -t "$SESSION"; fi
else
    echo "tmux session $SESSION started: tmux attach -t $SESSION"
fi
